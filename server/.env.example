# ==============================================================================
# CareerForge Node.js Express Backend - Environment Configuration
# ==============================================================================

# Server Environment & Port
PORT=5000
NODE_ENV=production

# MongoDB Production URI (MongoDB Atlas or Self-Hosted Replica Set with TLS)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/learnhub?retryWrites=true&w=majority&tls=true
MONGO_URI=mongodb://localhost:27017/learnhub
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5

# JSON Web Token (JWT) Configuration
# Generate high-entropy production key: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated for multiple origins)
CLIENT_URL=https://your-domain.com
CORS_ORIGIN=https://your-domain.com,https://app.your-domain.com

# FastAPI AI Microservice URL (Internal network / VPC address in production)
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=15000
