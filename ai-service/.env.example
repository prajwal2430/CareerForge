# ==============================================================================
# CareerForge AI Microservice (FastAPI) - Environment Configuration
# ==============================================================================

# Service Port & Mode
PORT=8000
ENVIRONMENT=production
LOG_LEVEL=info
SERVICE_NAME=career-forge-ai

# Google Gemini API Key
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
# In production, never commit this key to version control.
GEMINI_API_KEY=your_production_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30

# MongoDB Connection (Isolated replica set / Atlas connection string with TLS)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/learnhub?retryWrites=true&w=majority&tls=true
MONGO_URI=mongodb://localhost:27017/learnhub
MONGO_DB_NAME=learnhub

# CORS Allowed Origins (Comma-separated list of authorized domains)
# Example: https://your-domain.com,https://api.your-domain.com,http://localhost:3000,http://localhost:5000
ALLOWED_ORIGINS=https://your-domain.com,https://api.your-domain.com,http://localhost:3000,http://localhost:5000
